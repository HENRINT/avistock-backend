<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="avistock_db" transaction-type="RESOURCE_LOCAL">
        <!-- Proveedor de Hibernate para Jakarta -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Registra aquí tus clases de entidad si es necesario -->
        <class>com.avistock.model.Usuario</class>
        <class>com.avistock.model.Cliente</class>
        <class>com.avistock.model.Apartado</class> <!-- NUEVO: Módulo Cliente -->
        <class>com.avistock.model.Producto</class><!-- NUEVO: Catálogo de Stock -->
        <class>com.avistock.model.VentasMostrador</class>
        <class>com.avistock.model.DetalleVenta</class>
        <class>com.avistock.model.CierreCaja</class> <!-- NUEVO: faltaba, rompía consultas JPA de cierres de caja -->
        <class>com.avistock.model.NotificacionCaja</class> <!-- NUEVO: notificaciones persistentes dueño<->cajero -->

        <properties>
            <!-- Configuración de Conexión a la Base de Datos -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <!-- EXPLICACIÓN: se eliminó el user=root/password="" hardcodeado que vivía
                 aquí versionado en Git. Main.java inyecta URL/usuario/password reales
                 desde el .env en tiempo de ejecución. Nunca debe quedar una credencial,
                 aunque sea de desarrollo, escrita en un archivo del repositorio. -->

            <!-- Propiedades de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <!-- EXPLICACIÓN: false en producción. show_sql/format_sql imprimen cada
                 consulta completa y formateada a stdout en cada request; en una
                 instancia de 908MB eso es I/O y memoria del logger gastados sin rotar. -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- EXPLICACIÓN: Hibernate sin esto usa su pool interno, que su propia doc
                 marca como NO apto para producción (sin límite de espera, sin validar
                 conexiones muertas). Con cajero + dueño + clientes web concurrentes en
                 una instancia pequeña, agotarse de conexiones puede colgar/tumbar el
                 proceso completo. HikariCP es el pool estándar de producción. -->
            <property name="hibernate.connection.provider_class"
                       value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.maximumPoolSize" value="8"/>
            <property name="hibernate.hikari.idleTimeout" value="30000"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
        </properties>
    </persistence-unit>
</persistence>